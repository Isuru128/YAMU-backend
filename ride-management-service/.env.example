# ==========================================
# Ride Management Service Environment Configuration
# ==========================================
# Server port
SERVER_PORT=8082

# MongoDB Database URI (Database-per-service boundary: yamu_ride_db)
# For local MongoDB: mongodb://localhost:27017/yamu_ride_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/yamu_ride_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/yamu_ride_db

# JWT Security Configuration (Must match Account Service secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Inter-Service Communication Base URLs
ACCOUNT_SERVICE_URL=http://localhost:8080
DRIVER_SERVICE_URL=http://localhost:8081
PAYMENT_SERVICE_URL=http://localhost:8083
