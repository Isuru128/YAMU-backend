# ==============================================================================
# YAMU Backend - Root Environment Configuration Example
# ==============================================================================
# Copy this file or use service-specific .env files in each service directory.
#
# Common Security Settings (Must be identical across all microservices)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 1. Account Service (Default Port: 8080)
# ------------------------------------------------------------------------------
ACCOUNT_SERVICE_PORT=8080
ACCOUNT_SERVICE_MONGODB_URI=mongodb://localhost:27017/yamu_account_db

# ------------------------------------------------------------------------------
# 2. Driver & Vehicle Service (Default Port: 8081)
# ------------------------------------------------------------------------------
DRIVER_SERVICE_PORT=8081
DRIVER_SERVICE_MONGODB_URI=mongodb://localhost:27017/yamu_driver_db

# ------------------------------------------------------------------------------
# 3. Ride Management Service (Default Port: 8082)
# ------------------------------------------------------------------------------
RIDE_SERVICE_PORT=8082
RIDE_SERVICE_MONGODB_URI=mongodb://localhost:27017/yamu_ride_db

# ------------------------------------------------------------------------------
# 4. Payment Service (Default Port: 8083)
# ------------------------------------------------------------------------------
PAYMENT_SERVICE_PORT=8083
PAYMENT_SERVICE_MONGODB_URI=mongodb://localhost:27017/yamu_payment_db

# ------------------------------------------------------------------------------
# Interservice Host URLs
# ------------------------------------------------------------------------------
ACCOUNT_SERVICE_URL=http://localhost:8080
DRIVER_SERVICE_URL=http://localhost:8081
RIDE_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8083
