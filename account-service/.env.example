# ==========================================
# Account Service Environment Configuration
# ==========================================
# Server port
SERVER_PORT=

# MongoDB Database URI (Database-per-service boundary: yamu_account_db)
# For local MongoDB: mongodb://localhost:27017/yamu_account_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/yamu_account_db?retryWrites=true&w=majority
MONGODB_URI=

# JWT Security Configuration (Must be identical across all microservices)
JWT_SECRET=
JWT_EXPIRATION_MS=

# Inter-Service Communication Base URLs
DRIVER_SERVICE_URL=
RIDE_SERVICE_URL=
PAYMENT_SERVICE_URL=
